{
  "name": "mira_ai_sdk",
  "version": "1.0.0",
  "description": "通用 AI SDK 网关：管理多个 OpenAI 兼容服务商，提供聊天与图片生成 API（含 AI 图片生成器 web 应用）。",
  "author": "Mira Team",
  "license": "ISC",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "components/**/*",
    "scripts/**/*",
    "presets.json",
    "web/**/*",
    "package.json",
    "README.md"
  ],
  "mira": {
    "id": "mira_ai_sdk",
    "title": "AI 服务商",
    "icon": "smart_toy",
    "category": "integration",
    "tags": [
      "ai",
      "ai-sdk",
      "聊天",
      "图片生成",
      "openai-compatible"
    ]
  },
  "scripts": {
    "build": "tsc",
    "fetch-presets": "node scripts/fetch-presets.mjs",
    "build:web": "cd web && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.35",
    "ai": "^7.0.77"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.7.0"
  }
}
