{
  "name": "mira-web",
  "version": "1.0.2",
  "main": "dist-main/main.js",
  "homepage": "./",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "cnpm run build && cnpm run build:main && cnpm run build:preload",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:prod": "cross-env NODE_ENV=production cnpm run build:all",
    "electron:dev": "chcp 65001 && cross-env NODE_ENV=development vite --mode electron",
    "electron:dev:mac": "vite --mode electron",
    "electron:start": "node scripts/start-electron.js",
    "electron:build": "cnpm run build:prod && electron-builder",
    "electron:build:win": "cnpm run build:prod && electron-builder --win",
    "electron:build:mac": "cnpm run build:prod && electron-builder --mac",
    "pack": "cnpm run build:prod && electron-builder --dir",
    "electron:build:test": "cnpm run build:prod && electron-builder --config electron-builder.test.json",
    "pack:test": "cnpm run build:prod && electron-builder --config electron-builder.test.json --dir",
    "build:production": "node scripts/build-production.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "docs": "typedoc",
    "analyze:deps": "depcruise src --output-type html --output-to docs/dependencies.html",
    "analyze:bundle": "cnpm run build:prod && vite-bundle-analyzer dist-renderer",
    "clean": "rimraf dist-renderer dist-main dist-preload build docs/api docs/dependencies.html docs/dependencies.svg"
  },
  "keywords": [
    "electron",
    "vue",
    "typescript",
    "mira",
    "media-library"
  ],
  "author": "Mira Team",
  "license": "MIT",
  "description": "Mira Media Library Desktop Application",
  "dependencies": {
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "4.0.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorthief": "^2.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "extract-zip": "^2.0.1",
    "filepond": "^4.32.8",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^1.0.0",
    "mira-server-sdk": "^1.0.19",
    "pinia": "^3.0.3",
    "pinyin": "^4.0.0",
    "plyr": "^3.8.3",
    "postcss": "^8.5.6",
    "queue": "^7.0.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.0.17",
    "throttle-debounce": "^5.0.2",
    "typescript": "~5.7.2",
    "v-viewer": "^3.0.22",
    "vaul-vue": "^0.4.1",
    "viewerjs": "^1.11.7",
    "vite": "^6.2.0",
    "vue": "3.5.13",
    "vue-draggable-plus": "^0.6.0",
    "vue-filepond": "^7.0.4",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "vue-waterfall-plugin-next": "^2.6.9",
    "vue3-lazyload": "^0.3.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "@types/electron-window-state": "^2.0.34",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.13",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^17.0.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.12",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vue-tsc": "^2.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
