{
  "name": "mira-web",
  "version": "1.0.5",
  "main": "dist-main/main.js",
  "homepage": "./",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "pnpm run build && pnpm run build:main && pnpm run build:preload && pnpm run build:float",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:float": "node scripts/build-float.js",
    "build:prod": "cross-env NODE_ENV=production pnpm run build:all",
    "electron:dev": "chcp 65001 && cross-env NODE_ENV=development vite --mode electron",
    "electron:dev:mac": "vite --mode electron",
    "electron:kill": "node scripts/kill-electron.js",
    "electron:start": "node scripts/start-electron.js",
    "server:start": "node scripts/mira-server-service.mjs start",
    "server:status": "node scripts/mira-server-service.mjs status",
    "server:stop": "node scripts/mira-server-service.mjs stop",
    "electron:build:win": "pnpm run build:prod && electron-builder --win",
    "electron:build:mac": "pnpm run build:prod && electron-builder --mac",
    "build:production": "node scripts/build-production.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "docs": "typedoc",
    "analyze:deps": "depcruise src --output-type html --output-to docs/dependencies.html",
    "analyze:bundle": "pnpm run build:prod && vite-bundle-analyzer dist-renderer",
    "clean": "rimraf dist-renderer dist-main dist-preload dist-float build docs/api docs/dependencies.html docs/dependencies.svg"
  },
  "keywords": [
    "electron",
    "vue",
    "typescript",
    "mira",
    "media-library"
  ],
  "author": "Mira Team",
  "license": "MIT",
  "description": "Mira Media Library Desktop Application",
  "dependencies": {
    "@he-tree/vue": "^2.10.5",
    "@hunmer/vue-masonry": "workspace:*",
    "@internationalized/date": "^3.12.3",
    "@lucide/vue": "^1.17.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "4.0.17",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorthief": "^2.6.0",
    "cropper-next-vue": "^0.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "electron-window-state": "^5.0.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "extract-zip": "^2.0.1",
    "filepond": "^4.32.8",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "grid-layout-plus": "2.0.0-beta.0",
    "hls.js": "^1.6.17",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.5.6",
    "mira-app-core": "workspace:*",
    "motion-v": "^2.2.1",
    "pinia": "^3.0.3",
    "pinyin": "^4.0.0",
    "plyr": "^3.8.3",
    "postcss": "^8.5.6",
    "queue": "^7.0.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.0.17",
    "throttle-debounce": "^5.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "v-viewer": "^3.0.22",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.13.0",
    "viewerjs": "^1.11.7",
    "vite": "^6.2.0",
    "vue": "3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-filepond": "^7.0.4",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9",
    "vue3-lazyload": "^0.3.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "@types/electron-window-state": "^2.0.34",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.13",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^17.0.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.12",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vue-tsc": "^2.2.4"
  }
}
