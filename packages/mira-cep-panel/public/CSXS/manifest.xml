<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.hunmer.mira"
                   ExtensionBundleVersion="0.1.0"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.hunmer.mira.panel" Version="0.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Photoshop 2020(v21)起 -->
      <Host Name="PHXS" Version="[21.0,99.9]"/>
      <Host Name="PHSP" Version="[21.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.hunmer.mira.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <!-- mira server 无 CORS,CEP 内无代理可走,按 CEP 惯例放开跨域 -->
            <Parameter>--disable-web-security</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Mira 素材库</Menu>
          <Geometry>
            <Size>
              <Height>680</Height>
              <Width>1000</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>720</Width>
            </MinSize>
            <!-- 不写 MaxSize 时 PS 会把最大尺寸钉在初始值,面板无法拖大 -->
            <MaxSize>
              <Height>4096</Height>
              <Width>4096</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
