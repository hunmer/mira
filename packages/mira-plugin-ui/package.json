{
  "name": "mira-plugin-ui",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Mira 插件共享 UI 组件库：自包含 dist，可经 CDN 引入，不依赖宿主页面的组件库",
  "main": "./dist/mira-plugin-ui.umd.js",
  "module": "./dist/mira-plugin-ui.es.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/mira-plugin-ui.es.js",
      "require": "./dist/mira-plugin-ui.umd.js"
    },
    "./library": {
      "types": "./src/library/index.ts",
      "import": "./src/library/index.ts"
    },
    "./mira-plugin-ui.css": "./dist/mira-plugin-ui.css",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@hunmer/vue-masonry": "workspace:*",
    "@hunmer/vue-selection-box": "workspace:*",
    "@lucide/vue": "^1.32.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.2.1",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "3.5.13"
  }
}
