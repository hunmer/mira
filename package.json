{
  "name": "@hunmer/mira-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Mira TypeScript project - monorepo with core, server, and plugins",
  "scripts": {
    "install:deps": "node scripts/install-build.mjs packages/mira-app-core packages/mira-app-server packages/mira-client",
    "build:plugins": "node scripts/install-build.mjs \"plugins/plugins/*\"",
    "build:client-plugins-index": "node scripts/build-client-plugins-index.mjs",
    "dev:client-plugins": "node scripts/build-client-plugins-index.mjs --watch --serve",
    "start:server": "pnpm run install:deps && pnpm run build:plugins",
    "start:client:win": "pnpm -C packages/mira-client run electron:dev",
    "start:client:mac": "pnpm -C packages/mira-client run electron:dev:mac",
    "start:landing": "pnpm -C packages/landing-page run dev",
    "start:browser-extension": "pnpm -C packages/mira-browser-extension run dev",
    "start:plugin-ui": "pnpm -C packages/mira-plugin-ui run dev"
  },
  "keywords": [
    "mira",
    "typescript",
    "server",
    "plugins"
  ],
  "author": "hunmer",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sqlite3",
      "sharp"
    ],
    "overrides": {
      "express": "4.22.2"
    }
  }
}
