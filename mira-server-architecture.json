  "cards": [
    {
      "dot": "cyan",
      "title": "主数据路径",
      "items": [
        "客户端经 MiraClient SDK 携 Bearer Token 调用 REST API",
        "权限中间件校验令牌与素材库级角色（RBAC）",
        "路由经 LibraryStorage 读写进程内 SQLite 引擎"
      ]
    },
    {
      "dot": "amber",
      "title": "运行时子系统",
      "items": [
        "缩略图：并发队列(5)，ffmpeg / ImageMagick / Ghostscript，HLS 切片缓存",
        "Watcher：chokidar 监听媒体目录，启动时全量扫描增量入库",
        "导入与下载：Metadata 规则解析，DownloadExecutor 消费 Cookie 站点任务"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "① 网络入口：公开路由白名单 + 令牌 + 库级角色",
        "② 进程内插件：第三方代码与服务器同进程全权限运行",
        "③④ 宿主机：可派生转码子进程并直接读写媒体库与 data/",
        "⑤ 互联网：下载执行器与插件可外呼外部站点"
      ]
    },
    {
      "dot": "slate",
      "title": "未入图的辅助部分",
      "items": [
        "SettingsManager / UserStorage：data/ 下配置与账户",
        "DatabaseBackupService：定时备份数据库",
        "静态托管 /web /dashboard 与 SSE 日志流 /logs/stream",
        "CLI 与 MCP 为独立进程，复用同一 HTTP API + 令牌"
      ]
    }
  ]
}
