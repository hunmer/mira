{
  "commands": {
    "mira-app-server-dev": {
      "script": "pnpm",
      "args": [
        "--filter",
        "mira-app-server",
        "run",
        "dev"
      ],
      "roomId": "mira-dev"
    },
    "mira-client-dev": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-client",
        "run",
        "dev"
      ],
      "roomId": "mira-dev"
    },
    "mira-client-dev-win": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-client",
        "run",
        "dev"
      ],
      "roomId": "mira-dev"
    },
    "mira-dashboard-next-dev": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-dashboard-next",
        "run",
        "dev"
      ]
    },
    "mira-dashboard-next-dev-win": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-dashboard-next",
        "run",
        "dev"
      ]
    },
    "mira-browser-extension-dev": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-browser-extension",
        "run",
        "dev"
      ],
      "group": "mira_typescript"
    },
    "mira-plugin-ui-dev": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-plugin-ui",
        "run",
        "dev"
      ],
      "group": "mira_typescript"
    },
    "mira-doc-dev": {
      "script": "pnpm",
      "args": [
        "-C",
        "packages/mira-doc",
        "run",
        "docs:dev"
      ]
    },
    "env-probe": {
      "script": "node",
      "args": [
        "-e",
        "console.log(\"ROOM_ID=\", process.env.PROCM_ROOM_ID); console.log(\"WS_URL=\", process.env.PROCM_WS_URL)"
      ],
      "roomId": "mira-dev"
    }
  }
}
